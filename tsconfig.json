{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "check-types: src (tests included) and scripts",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "module": "ESNext",
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  // *.test.ts files ARE type-checked: an @ts-expect-error in a test is a
  // real assertion.
  "include": ["src", "scripts"],
  "exclude": ["node_modules", "dist"]
}
