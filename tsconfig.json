{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "check-types: src (tests included) and scripts",
  // tooling: scripts, tests and fixtures never ship, so this check runs
  // without isolatedDeclarations; tsconfig.build.json holds the shipped
  // src to it.
  "extends": ["@open-tomato/typescript-config/bun", "@open-tomato/typescript-config/tooling"],
  "compilerOptions": {
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  // *.test.ts files ARE type-checked: an @ts-expect-error in a test is a
  // real assertion.
  "include": ["src", "scripts"],
  "exclude": ["node_modules", "dist"]
}
