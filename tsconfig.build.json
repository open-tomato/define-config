{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "build: declarations for the published src, tests and fixtures excluded",
  "extends": ["./tsconfig.json", "@open-tomato/typescript-config/declarations"],
  "compilerOptions": {
    "isolatedDeclarations": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/**/fixtures/**"]
}
